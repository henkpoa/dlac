# Transient / per-character -- not shared.
gear_staging.lua
backups/

# Debug report drops ('/dl check', '/dl debug <topic>' write transferable
# .txt reports here for remote support -- player artifacts, never tracked).
debug/

# Local-only maintainer tools: the CatsEyeXI API scraper, the server mod-id map, and the
# item-id list. Untracked so we don't publish how-to-scrape or the mod enum -- the built
# catalog.lua (shipped) is what users need. Files stay on disk; this only stops tracking.
tools/

# Hand-off bundles built for people outside the project (share/mob-stats = the mob
# EVA/ACC calculator + its write-up). Self-contained copies, meant to be zipped and
# sent, never tracked -- the canonical source stays where it lives in the repo.
share/

# Python bytecode (from running the tools locally)
__pycache__/
*.pyc
luac.out
